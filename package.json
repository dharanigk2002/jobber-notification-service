{
  "name": "jobber-notification-service",
  "version": "1.0.0",
  "description": "Notification service to send emails",
  "main": "app.js",
  "scripts": {
    "start": "pm2 start ./build/app.js -i 5 --attach --watch | pino-pretty -c",
    "stop": "pm2 stop all",
    "delete": "pm2 delete all",
    "clean": "rimraf ./build",
    "build": "npm run clean && ts-patch install && tsc && node scripts/copy-email-templates.js",
    "compile:watch": "ts-patch install && node scripts/copy-email-templates.js && tsc --watch",
    "run:js": "node --watch ./build/app.js",
    "dev": "concurrently -n \"TypeScript,Node\" -c \"cyan,green\" \"npm run compile:watch\" \"npm run run:js\"",
    "test": "cross-env NODE_OPTIONS=\"--experimental-vm-modules\" jest --coverage=true -w=1 --forceExit --detectOpenHandles --watchAll=false"
  },
  "keywords": [],
  "devDependencies": {
    "@jest/types": "^30.5.1",
    "@types/amqplib": "^0.10.8",
    "@types/email-templates": "^10.0.4",
    "@types/express": "^5.0.6",
    "@types/jest": "^30.0.0",
    "@types/node": "^26.6.5",
    "@types/nodemailer": "^8.0.2",
    "@typescript-eslint/eslint-plugin": "^8.72.0",
    "@typescript-eslint/parser": "^8.72.0",
    "concurrently": "^10.0.6",
    "cross-env": "^10.1.0",
    "eslint": "^10.13.0",
    "jest": "^30.5.2",
    "ts-jest": "^29.4.15",
    "ts-patch": "^4.0.1",
    "tsx": "^4.23.15",
    "typescript-transform-paths": "^4.0.0"
  },
  "dependencies": {
    "@dharanigk2002/jobber-shared": "^1.0.10",
    "@elastic/elasticsearch": "^9.5.1",
    "amqplib": "^2.2.0",
    "dotenv": "^18.0.9",
    "ejs": "^3.1.10",
    "email-templates": "^13.0.1",
    "express": "^5.3.0",
    "http-status-codes": "^2.3.0",
    "nodemailer": "^10.2.1",
    "pino-pretty": "^13.2.0",
    "rimraf": "^6.1.3",
    "winston": "^3.19.0"
  },
  "allowScripts": {
    "esbuild@0.28.2": true,
    "@parcel/watcher@2.6.0": true,
    "unrs-resolver@1.12.2": true
  },
  "type": "module"
}
